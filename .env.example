# Copy to .env and fill in. Never commit real keys.
NIMBLE_API_KEY=
LIQUID_API_KEY=
# Alternative to LIQUID_API_KEY if routing Liquid models via OpenRouter
OPENROUTER_API_KEY=
# Liquid (lab-submission extraction): "openrouter" (hosted, default) or "ollama" (local)
LIQUID_PROVIDER=openrouter
LIQUID_MODEL=liquid/lfm-2.5-2.6b:free
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=LiquidAI/lfm2.5-350m
RAWTREE_API_KEY=
BFL_API_KEY=
